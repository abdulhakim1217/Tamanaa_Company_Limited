# Production Environment Variables for Vercel Deployment
NODE_ENV=production

# Application Configuration
NEXT_PUBLIC_APP_NAME="Tamanaa Rice Processing"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# Database Configuration (Mock mode for standalone deployment)
# DATABASE_URL is intentionally not set to use mock data mode
# SUPABASE_URL is intentionally not set to use standalone mode
# SUPABASE_ANON_KEY is intentionally not set to use standalone mode

# Vercel Analytics (optional)
# VERCEL_ANALYTICS_ID will be automatically set by Vercel

# Currency Configuration
NEXT_PUBLIC_CURRENCY=GHS
NEXT_PUBLIC_LOCALE=en-GH

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_MOBILE=true
NEXT_PUBLIC_STANDALONE_MODE=true